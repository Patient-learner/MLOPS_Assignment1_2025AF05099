      "id": 4,
      "title": "P95 Latency (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket[1m])) by (le)) * 1000) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "HTTP Request Throughput (Req / sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Inference Latency by Endpoint (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(request_latency_seconds_sum[1m])) by (endpoint) / sum(rate(request_latency_seconds_count[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}} avg latency",
          "refId": "A"
        }
      ]
    }
